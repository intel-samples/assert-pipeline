# Copy this file to docker/.env and fill in local values.

# Required secrets
LLM_API_KEY=

# Runtime settings
# Pricing map fetched fresh from LiteLLM upstream; override with your own URL if needed.
LITELLM_MODEL_COST_MAP_URL=https://raw.githubusercontent.com/BerriAI/litellm/main/model_prices_and_context_window.json

# Local host bindings
LOCAL_UID=1000
LOCAL_GID=1000
SUT_PATH=../test_project/